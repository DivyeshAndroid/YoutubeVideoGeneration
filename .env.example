# Generation
CONTENT_FILE=content/example.json
OUTPUT_DIR=output
# YouTube Shorts: vertical 9:16, with a maximum duration of 60 seconds.
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_DURATION_SECONDS=60
FPS=30
VIDEO_CRF=18
VIDEO_PRESET=slow
AUDIO_BITRATE=192k

# Content mode: local or trending. Trending uses Codex CLI plus keyless RSS.
CONTENT_MODE=local
AI_PROVIDER=codex
CODEX_COMMAND=codex
CODEX_MODEL=gpt-6.1-sol
CODEX_REASONING_EFFORT=low

# Optional fallback if you later want Ollama.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
NEWS_TOPIC=technology and artificial intelligence
NEWS_REGION=India and global
NEWS_LOOKBACK_HOURS=24
# Keyless sources fetched in parallel. Hacker News is used only for tech-like topics.
NEWS_PROVIDERS=google-rss,gdelt,hacker-news
NEWS_MAX_ITEMS=30
NEWS_HISTORY_FILE=work/news-history.json
MAX_SCENES=5
HASHTAG_COUNT=8
# styled = no downloads, source = article image, comfyui = local, leonardo = browser automation
IMAGE_MODE=source
GENERATE_IMAGES=true
# Optional: use pre-generated scene-0.png, scene-1.png, etc. from this directory.
SCENE_IMAGE_DIR=

# Local image generation: ComfyUI with an SDXL-compatible checkpoint.
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors
COMFYUI_STEPS=24

# Leonardo image generation. Runs headless unless the saved session expires.
LEONARDO_HEADLESS=true
# Manual commands may open sign-in; the background runner disables this.
LEONARDO_INTERACTIVE_AUTH=true
LEONARDO_USER_DATA_DIR=work/leonardo-profile
LEONARDO_PROFILE_DIRECTORY=Default
# Leave blank for automatic Chrome detection on macOS and Windows.
LEONARDO_CHROME_PATH=
LEONARDO_TIMEOUT_MS=300000
# Visible login window can remain open for up to ten minutes.
LEONARDO_AUTH_TIMEOUT_MS=600000
LEONARDO_GENERATOR_URL=https://app.leonardo.ai/generate?model=auto-preset&aspectRatio=1%3A1&style=a5632c7c-ddbb-4e2f-ba34-8456ab3ac436&mode=fast&quantity=1&seedEnabled=false&negativePromptEnabled=false
LEONARDO_MAX_ATTEMPTS=3

# VoiceStudio is primary; if it is unavailable, narration automatically falls
# back to Clipchamp for the remainder of that run.
NARRATION_PROVIDER=voicestudio

# Neural presenter voice (set NARRATION_PROVIDER=edge). Requires Python + edge-tts.
# Install: python -m pip install -r requirements-tts.txt
EDGE_TTS_PYTHON=python
EDGE_TTS_VOICE=en-US-AriaNeural
EDGE_TTS_RATE=+0%

# Optional local fallback provider settings (set NARRATION_PROVIDER=local).
PIPER_COMMAND=piper
PIPER_MODEL=secrets/voices/en_US-lessac-high.onnx

# Clipchamp narration and VoiceStudio fallback. The first visible run lets you
# sign in; the session is then reused from CLIPCHAMP_USER_DATA_DIR.
CLIPCHAMP_LANGUAGE=
CLIPCHAMP_VOICE_NAME=Aria
# The saved login profile allows normal runs to remain fully headless.
CLIPCHAMP_HEADLESS=true
CLIPCHAMP_USER_DATA_DIR=work/clipchamp-profile
# Leave blank for automatic Chrome detection on macOS and Windows.
CLIPCHAMP_CHROME_PATH=
CLIPCHAMP_TIMEOUT_MS=120000

# VoiceStudio local API. The desktop app is started automatically when
# its local API is not already running; failed startup/generation uses Clipchamp.
VOICESTUDIO_BASE_URL=http://127.0.0.1:3900
VOICESTUDIO_API_KEY=
VOICESTUDIO_LANGUAGE=Auto
# Optional saved voice profile ID from VoiceStudio; blank uses its default voice.
VOICESTUDIO_PROFILE_ID=
# Optional style direction, for example: warm documentary narrator
VOICESTUDIO_INSTRUCT=An adult female news anchor with clear, composed corporate-presenter delivery.
VOICESTUDIO_SPEED=1.25
# 8 = draft, 16 = balanced, 32 = quality
VOICESTUDIO_STEPS=16
VOICESTUDIO_TIMEOUT_MS=300000
VOICESTUDIO_AUTOSTART=true
# Leave blank for standard macOS/Windows installation detection, or set the full executable path.
VOICESTUDIO_APP_PATH=
VOICESTUDIO_STARTUP_TIMEOUT_MS=120000

# Automation: every day at 09:00 local time
CRON_SCHEDULE=0 9 * * *
TIMEZONE=Asia/Kolkata

# Upload safety: upload remains disabled until explicitly changed to true.
YOUTUBE_UPLOAD_ENABLED=false
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_CLIENT_SECRET_FILE=secrets/youtube-client-secret.json
YOUTUBE_TOKEN_FILE=secrets/youtube-token.json
