# Windows news-video configuration. Copy to .env after installing dependencies.
CONTENT_MODE=trending
AI_PROVIDER=codex
NEWS_TOPIC=technology and artificial intelligence
NEWS_REGION=India and global
NEWS_LOOKBACK_HOURS=24
NEWS_HISTORY_FILE=work/news-history.json
GENERATE_IMAGES=true
IMAGE_MODE=source
LEONARDO_HEADLESS=true
LEONARDO_USER_DATA_DIR=work/leonardo-profile
NARRATION_PROVIDER=edge
EDGE_TTS_PYTHON=work/edge-tts-venv/Scripts/python.exe
EDGE_TTS_VOICE=en-US-AriaNeural
EDGE_TTS_RATE=+0%
CRON_SCHEDULE=0 * * * *
TIMEZONE=Asia/Kolkata
YOUTUBE_UPLOAD_ENABLED=false
